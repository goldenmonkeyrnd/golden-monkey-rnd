{
  "name": "goldenmonkey-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/import-sentinels.ts && hugo server --buildDrafts --buildFuture --bind 127.0.0.1 --port 1313",
    "build": "bun scripts/import-sentinels.ts && hugo --gc --minify --cleanDestinationDir",
    "check": "tsc --noEmit && bun scripts/test-sentinels-import.ts && bun scripts/test-sentinels-promotion.ts && bun scripts/check-site.ts",
    "deploy": "bun run build && wrangler deploy",
    "check:browser": "bun scripts/check-lab-browser.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
