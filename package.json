{
  "name": "goldenmonkey-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/import-sentinels.ts && hugo server --bind 127.0.0.1 --port 1313",
    "build": "bun scripts/import-sentinels.ts && hugo --gc --minify --cleanDestinationDir",
    "check": "bun scripts/test-sentinels-import.ts && bun scripts/check-site.ts",
    "deploy": "bun run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
